{
  "name": "ccmon",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dump": "node src/cli/main.ts dump",
    "status": "node src/cli/main.ts status",
    "serve": "NODE_NO_WARNINGS=1 node src/cli/main.ts serve",
    "sub": "node src/cli/main.ts sub",
    "test": "vitest run",
    "lint": "npx biome check src/ tests/",
    "lint:fix": "npx biome check --write --unsafe src/ tests/",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "ccmon": "src/cli/main.ts"
  },
  "files": [
    "src",
    "public"
  ],
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
