{
  "name": "ccmon",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --external:ws",
    "dump": "tsx src/cli.ts dump",
    "serve": "tsx src/cli.ts serve",
    "sub": "tsx src/cli.ts sub",
    "test": "vitest run",
    "lint": "npx biome check src/ tests/",
    "lint:fix": "npx biome check --write --unsafe src/ tests/",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "ccmon": "dist/cli.js"
  },
  "files": [
    "dist",
    "public"
  ],
  "dependencies": {
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
